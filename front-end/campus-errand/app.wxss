page {
  background-color: #f5f7fb;
  font-size: 28rpx;
  color: #333;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.05);
}

/* 标题 */
.title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

/* 次要文字 */
.desc {
  color: #666;
  font-size: 26rpx;
}

/* 价格 */
.price {
  color: #ff4d4f;
  font-weight: bold;
}

/* 按钮 */
.btn {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #4facfe, #00c6ff);
  color: #fff;
  border-radius: 40rpx;
}
.input {
  border: 1px solid #eee;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}
.banner {
  margin: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 300rpx;
}
.empty {
  text-align: center;
  color: #999;
  margin-top: 200rpx;
  font-size: 28rpx;
}