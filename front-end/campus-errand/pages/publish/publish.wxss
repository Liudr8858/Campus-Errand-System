/* pages/publish/publish.wxss */

.container {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.input {
  border: 1px solid #ddd;
  padding: 20rpx;
  border-radius: 10rpx;
}

.textarea {
  border: 1px solid #ddd;
  padding: 20rpx;
  border-radius: 10rpx;
  height: 150rpx;
}

.btn {
  margin-top: 40rpx;
  background-color: #07c160;
  color: white;
  border-radius: 10rpx;
}